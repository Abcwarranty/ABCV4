{
  "name": "architects-certificate-wordpress-theme",
  "version": "1.0.0",
  "description": "Professional WordPress theme for architect certification services",
  "main": "index.php",
  "scripts": {
    "dev": "npm run watch",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./assets/css/src/main.css -o ./assets/css/dist/main.css --minify",
    "build:js": "webpack --mode=production",
    "watch": "npm run watch:css & npm run watch:js",
    "watch:css": "tailwindcss -i ./assets/css/src/main.css -o ./assets/css/dist/main.css --watch",
    "watch:js": "webpack --mode=development --watch",
    "lint": "eslint assets/js/",
    "lint:fix": "eslint assets/js/ --fix",
    "zip": "zip -r architects-certificate-theme.zip . -x node_modules/\\* .git/\\* *.zip"
  },
  "keywords": [
    "wordpress",
    "theme",
    "architecture",
    "certification",
    "professional",
    "responsive"
  ],
  "author": "ABC Warranty",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.42.0",
    "postcss": "^8.5",
    "tailwindcss": "^3.3.2",
    "typescript": "^5",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/architects-certificate-wordpress-theme.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/architects-certificate-wordpress-theme/issues"
  },
  "homepage": "https://github.com/yourusername/architects-certificate-wordpress-theme#readme",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "15.2.4",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  }
}